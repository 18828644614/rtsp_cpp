include("${CMAKE_CURRENT_LIST_DIR}/FFmpeg.cmake")
require_ffmpeg(avcodec avutil swresample)

add_library(aac_encoder STATIC src/media/audio_resampler.cpp src/media/aac_encoder.cpp)
target_include_directories(aac_encoder PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/src")
target_include_directories(aac_encoder SYSTEM PRIVATE "${FFMPEG_INCLUDE_DIR}")
target_link_libraries(aac_encoder PRIVATE FFmpeg::avcodec FFmpeg::avutil FFmpeg::swresample)
if(MSVC)
    target_compile_options(aac_encoder PUBLIC /W4 /utf-8)
else()
    target_compile_options(aac_encoder PUBLIC -Wall -Wextra -Wpedantic)
endif()

add_library(microphone_audio_source STATIC src/media/microphone_audio_source.cpp)
target_link_libraries(microphone_audio_source PUBLIC rtsp_core aac_encoder)
if(ENABLE_MICROPHONE_CAPTURE)
    target_sources(microphone_audio_source PRIVATE src/media/microphone_capture_input.cpp)
    target_link_libraries(microphone_audio_source PUBLIC microphone_capture)
endif()

target_link_libraries(rtsp_server PRIVATE microphone_audio_source FFmpeg::avutil)
target_compile_definitions(rtsp_server PRIVATE RTSP_HAS_AUDIO_SOURCE)
if(ENABLE_MICROPHONE_CAPTURE)
    target_compile_definitions(rtsp_server PRIVATE RTSP_HAS_MICROPHONE_CAPTURE)
endif()
copy_ffmpeg_runtime(rtsp_server)

add_executable(aac_encode_probe src/app/aac_encode_probe_main.cpp)
target_link_libraries(aac_encode_probe PRIVATE microphone_audio_source FFmpeg::avutil)
if(ENABLE_MICROPHONE_CAPTURE)
    target_compile_definitions(aac_encode_probe PRIVATE RTSP_HAS_MICROPHONE_CAPTURE)
endif()
if(MINGW)
    target_link_options(aac_encode_probe PRIVATE -municode)
endif()
copy_ffmpeg_runtime(aac_encode_probe)

if(BUILD_TESTING)
    add_executable(microphone_audio_source_tests tests/microphone_audio_source_tests.cpp)
    target_link_libraries(microphone_audio_source_tests PRIVATE microphone_audio_source FFmpeg::avutil)
    copy_ffmpeg_runtime(microphone_audio_source_tests)
    add_test(NAME microphone_audio_source_tests COMMAND microphone_audio_source_tests)
    set_tests_properties(microphone_audio_source_tests PROPERTIES TIMEOUT 15)

    add_executable(aac_encoder_tests tests/aac_encoder_tests.cpp)
    target_include_directories(aac_encoder_tests SYSTEM PRIVATE "${FFMPEG_INCLUDE_DIR}")
    target_link_libraries(aac_encoder_tests PRIVATE aac_encoder rtsp_core FFmpeg::avcodec FFmpeg::avutil)
    copy_ffmpeg_runtime(aac_encoder_tests)
    add_test(NAME aac_encoder_tests COMMAND aac_encoder_tests)
    set_tests_properties(aac_encoder_tests PROPERTIES TIMEOUT 30)
    add_test(NAME aac_encode_probe_help COMMAND aac_encode_probe --help)
    add_test(NAME aac_encode_probe_invalid_option COMMAND aac_encode_probe --not-an-option)
    add_test(NAME aac_encode_probe_missing_value COMMAND aac_encode_probe --seconds)
    add_test(NAME aac_encode_probe_conflicting_input COMMAND aac_encode_probe --synthetic --device test)
    set_tests_properties(aac_encode_probe_invalid_option aac_encode_probe_missing_value
        aac_encode_probe_conflicting_input PROPERTIES WILL_FAIL TRUE TIMEOUT 10)
    add_test(NAME aac_encode_probe_synthetic COMMAND aac_encode_probe --synthetic --seconds 1
        --output "${CMAKE_CURRENT_BINARY_DIR}/audio-probe.aac")
    set_tests_properties(aac_encode_probe_help aac_encode_probe_synthetic PROPERTIES TIMEOUT 15)
    find_package(Python3 COMPONENTS Interpreter QUIET)
    find_program(AUDIO_FFMPEG_EXECUTABLE NAMES ffmpeg)
    if(Python3_Interpreter_FOUND AND AUDIO_FFMPEG_EXECUTABLE)
        add_test(NAME audio_encoding_integration COMMAND "${Python3_EXECUTABLE}"
            "${CMAKE_CURRENT_SOURCE_DIR}/tests/verify_audio_encoding.py"
            --probe "$<TARGET_FILE:aac_encode_probe>" --server "$<TARGET_FILE:rtsp_server>"
            --ffmpeg "${AUDIO_FFMPEG_EXECUTABLE}" --output "${CMAKE_CURRENT_BINARY_DIR}/audio_integration")
        set_tests_properties(audio_encoding_integration PROPERTIES TIMEOUT 40)
    endif()
endif()
