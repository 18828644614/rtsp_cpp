include("${CMAKE_CURRENT_LIST_DIR}/FFmpeg.cmake")
require_ffmpeg(avdevice avformat avcodec avutil)

add_library(microphone_capture STATIC src/media/microphone_capture.cpp)
target_include_directories(microphone_capture PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/src")
target_include_directories(microphone_capture SYSTEM PRIVATE "${FFMPEG_INCLUDE_DIR}")
target_compile_definitions(microphone_capture PUBLIC WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0600)
target_link_libraries(microphone_capture PRIVATE
    FFmpeg::avdevice FFmpeg::avformat FFmpeg::avcodec FFmpeg::avutil
    ole32 oleaut32 strmiids)
if(MSVC)
    target_compile_options(microphone_capture PUBLIC /W4 /utf-8)
else()
    target_compile_options(microphone_capture PUBLIC -Wall -Wextra -Wpedantic)
endif()

add_executable(microphone_probe src/app/microphone_probe_main.cpp)
target_link_libraries(microphone_probe PRIVATE microphone_capture)
if(MINGW)
    target_link_options(microphone_probe PRIVATE -municode)
endif()
copy_ffmpeg_runtime(microphone_probe)

if(BUILD_TESTING)
    add_executable(microphone_capture_tests tests/microphone_capture_tests.cpp)
    target_include_directories(microphone_capture_tests SYSTEM PRIVATE "${FFMPEG_INCLUDE_DIR}")
    target_link_libraries(microphone_capture_tests PRIVATE microphone_capture FFmpeg::avutil)
    copy_ffmpeg_runtime(microphone_capture_tests)
    add_test(NAME microphone_capture_tests COMMAND microphone_capture_tests)
    set_tests_properties(microphone_capture_tests PROPERTIES TIMEOUT 15)
    add_test(NAME microphone_probe_help COMMAND microphone_probe --help)
    add_test(NAME microphone_probe_invalid_option COMMAND microphone_probe --not-an-option)
    add_test(NAME microphone_probe_missing_value COMMAND microphone_probe --seconds)
    add_test(NAME microphone_probe_invalid_number COMMAND microphone_probe --seconds -1)
    add_test(NAME microphone_probe_conflicting_device COMMAND microphone_probe --device test --device-index 0)
    set_tests_properties(microphone_probe_help microphone_probe_invalid_option PROPERTIES TIMEOUT 10)
    set_tests_properties(microphone_probe_invalid_option microphone_probe_missing_value
        microphone_probe_invalid_number microphone_probe_conflicting_device
        PROPERTIES WILL_FAIL TRUE TIMEOUT 10)
endif()
